{
  "schema": "unvac.avatar_reaction_presets.v1",
  "target_link_id": "kaltsit_ai",
  "channel": "avatar_intent",
  "presets": {
    "chat_agree": {
      "description": "Small agreement for chat or streamer voice.",
      "intents": [
        { "kind": "expression", "name": "smile", "intensity": 0.35, "duration_ms": 900, "curve": "hold" },
        { "kind": "head_nod", "count": 1, "intensity": 0.28, "duration_ms": 650, "curve": "ease_out" }
      ]
    },
    "channel_point_surprise": {
      "description": "Surprised reaction for channel point redemption or lightweight event.",
      "intents": [
        { "kind": "expression", "name": "surprised", "intensity": 0.45, "duration_ms": 900, "curve": "hold" },
        { "kind": "head_nod", "count": 1, "intensity": 0.3, "duration_ms": 650, "curve": "ease_out" }
      ]
    },
    "moderation_warning": {
      "description": "Short warning reaction for risky chat or moderation hint.",
      "intents": [
        { "kind": "expression", "name": "concerned", "intensity": 0.4, "duration_ms": 1100, "curve": "hold" },
        { "kind": "head_shake", "count": 1, "intensity": 0.25, "duration_ms": 800, "curve": "ease_out" }
      ]
    },
    "listening_nod": {
      "description": "Small listening nod for streamer voice.",
      "intents": [
        { "kind": "head_nod", "count": 1, "intensity": 0.24, "duration_ms": 600, "curve": "ease_out" }
      ]
    },
    "neutral": {
      "description": "Manual neutral return when expression remains.",
      "intents": [
        { "kind": "expression", "name": "neutral", "intensity": 1.0, "duration_ms": 300, "curve": "linear" }
      ]
    }
  },
  "suggested_bindings": [
    {
      "source": "twitch.chat.command",
      "match": "/avatar agree",
      "preset": "chat_agree"
    },
    {
      "source": "twitch.channel_point",
      "reward_title": "AI Reaction",
      "preset": "channel_point_surprise"
    },
    {
      "source": "twitch.chat.moderation_hint",
      "preset": "moderation_warning"
    },
    {
      "source": "voice.observe",
      "preset": "listening_nod"
    }
  ]
}
