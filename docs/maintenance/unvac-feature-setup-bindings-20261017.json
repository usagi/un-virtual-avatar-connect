    {
      "id": "twitch-notices",
      "title": "配信イベントを知らせる",
      "source": "flowgraph.example/twitch-event-notices/main.flowgraph.toml",
      "controls": [
        {
          "label": "受信に使うTwitchアカウント",
          "node_id": "eventsub",
          "feature": "flowgraph.ingress.twitch_eventsub",
          "property": "token_key",
          "example_value": "broadcaster",
          "value_type": "str"
        },
        {
          "label": "通知するイベント",
          "node_id": "eventsub",
          "feature": "flowgraph.ingress.twitch_eventsub",
          "property": "event_types",
          "example_value": [
            "channel.channel_points_custom_reward_redemption.add",
            "channel.follow",
            "channel.subscribe",
            "channel.subscription.message",
            "channel.subscription.gift",
            "channel.raid"
          ],
          "value_type": "list"
        },
        {
          "label": "画面の出力先",
          "node_id": "notice_destination",
          "feature": "flowgraph.literal.string",
