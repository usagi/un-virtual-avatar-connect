{
  "status": "adopted_guidance_bindings_not_full_runtime_acceptance",
  "rules": [
    "Settings edit the same installed graph, never replace it with the template.",
    "Resolve by node id AND feature; an unknown or rewired graph needs Studio review before a guided edit.",
    "Keep all other nodes, edges, groups, instances and metadata unchanged.",
    "Use source revision conflict checks and retain drafts on failure.",
    "Saved configuration is not proof of active execution.",
    "This covers the four bundled examples, not arbitrary user programs."
